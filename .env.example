# ==============================================================================
# SECURE CONFIGURATION & SECRET MANAGEMENT (OWASP A02:2021 Defense)
# ==============================================================================
# IMPORTANT: DO NOT HARDCODE PLAIN-TEXT KEYS OR CREDENTIALS IN THIS OR ANY FILE.
# All sensitive secrets must exclusively be provisioned through secure vaulting mechanisms
# (such as Google Secret Manager, HashiCorp Vault, AWS Secrets Manager, or platform-managed
# encrypted environment stores). Direct user input or hardcoding of keys is strictly prohibited.
# ==============================================================================

# GEMINI_API_KEY: Provisioned dynamically at server startup via platform secret manager.
# Do NOT populate with raw keys in repository files. Use platform vaulting mechanisms exclusively.
GEMINI_API_KEY=

# APP_URL: Dynamic service origin URL injected by runtime container orchestrator.
APP_URL=

